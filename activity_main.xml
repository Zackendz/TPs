<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/title"
        android:text="Café Express"
        android:textSize="25dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="30dp"/>
    <TextView
        android:id="@+id/soutitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pris de Commande"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/café"
        android:layout_marginTop="30dp"
        android:layout_marginStart="15dp"
        android:textStyle="bold"
        android:textSize="20dp"
        android:text="Café"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/soutitle"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/thé"
        android:layout_marginTop="40dp"
        android:layout_marginStart="15dp"
        android:textStyle="bold"
        android:textSize="20dp"
        android:text="Thé"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/café"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/croissant"
        android:layout_marginTop="40dp"
        android:layout_marginStart="15dp"
        android:textStyle="bold"
        android:textSize="20dp"
        android:text="Croissant"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/thé"
    />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/pris1"
        android:layout_marginStart="65dp"
        android:textSize="16dp"
        android:text="10 DH"
        app:layout_constraintStart_toEndOf="@id/café"
        app:layout_constraintBaseline_toBaselineOf="@+id/café"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/pris2"
        android:textSize="16dp"
        android:text="20 DH"
        app:layout_constraintStart_toStartOf="@id/pris1"
        app:layout_constraintBaseline_toBaselineOf="@+id/thé"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/pris3"
        android:textSize="16dp"
        android:text="8 DH"
        app:layout_constraintStart_toStartOf="@id/pris1"
        app:layout_constraintBaseline_toBaselineOf="@+id/croissant"/>
    <Button
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="0dp"
        android:id="@+id/m1"
        android:text="-"
        android:textSize="20dp"
        app:layout_constraintEnd_toEndOf="@+id/m2"
        app:layout_constraintBaseline_toBaselineOf="@id/pris1"
        android:layout_marginStart="20dp"
        />
    <Button
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="0dp"
        android:id="@+id/p1"
        android:text="+"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="15dp"
        app:layout_constraintBaseline_toBaselineOf="@id/pris1"
        android:layout_marginStart="20dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/qua1"
        android:textSize="16dp"
        android:text="0"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@+id/pris1"
        app:layout_constraintEnd_toEndOf="@id/qua2"
        />
    <Button
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="0dp"
        android:id="@+id/m2"
        android:text="-"
        android:textSize="20dp"
        app:layout_constraintEnd_toStartOf="@+id/qua2"
        android:layout_marginEnd="20dp"
        app:layout_constraintBaseline_toBaselineOf="@id/pris2"
        android:layout_marginStart="20dp"
        />
    <Button
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="0dp"
        android:id="@+id/p2"
        android:text="+"
        android:textSize="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="15dp"
        app:layout_constraintBaseline_toBaselineOf="@id/pris2"
        android:layout_marginStart="20dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/qua2"
        android:textSize="16dp"
        android:text="0"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@+id/pris2"
        app:layout_constraintEnd_toStartOf="@id/p2"
        android:layout_marginEnd="20dp"
        />
    <Button
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="0dp"
        android:id="@+id/m3"
        android:text="-"
        android:textSize="20dp"
        app:layout_constraintEnd_toStartOf="@+id/qua3"
        android:layout_marginEnd="20dp"
        app:layout_constraintBaseline_toBaselineOf="@id/pris3"
        android:layout_marginStart="20dp"
        />
    <Button
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="0dp"
        android:id="@+id/p3"
        android:text="+"
        android:textSize="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="15dp"
        app:layout_constraintBaseline_toBaselineOf="@id/pris3"
        android:layout_marginStart="20dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/qua3"
        android:textSize="16dp"
        android:text="0"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@+id/pris3"
        app:layout_constraintEnd_toStartOf="@id/p3"
        android:layout_marginEnd="20dp"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/client"
        app:layout_constraintStart_toStartOf="@+id/café"
        android:text="Nom du client"
        android:textStyle="bold"
        tools:ignore="MissingConstraints"
        android:textSize="18dp"
        app:layout_constraintTop_toBottomOf="@+id/croissant"
        android:layout_marginTop="40dp"/>
    <EditText
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:id="@+id/edtclient"
        app:layout_constraintStart_toStartOf="@+id/café"
        app:layout_constraintEnd_toEndOf="@+id/p1"
        android:textStyle="bold"
        tools:ignore="MissingConstraints"
        android:hint="Ex:Ahmed"
        app:layout_constraintTop_toBottomOf="@+id/client"
        />

    <TextView
        android:id="@+id/total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:text="Total:0DH"
        android:textSize="25dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edtclient" />
    <Button
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:id="@+id/vid"
        android:text="Vider"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="15dp"
        app:layout_constraintStart_toStartOf="@+id/café"
        />
    <Button
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/comm"
        android:text="Commander"
        app:layout_constraintStart_toEndOf="@+id/vid"
        app:layout_constraintTop_toTopOf="@+id/vid"
        app:layout_constraintEnd_toEndOf="@+id/p1"
        android:layout_marginStart="10dp"
        />
</androidx.constraintlayout.widget.ConstraintLayout>